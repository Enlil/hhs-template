# Reference only — each app manages its own real environment configuration
# idiomatically (apps/web/.env.example for Vite, apps/web/src/environments
# for Angular, apps/api/.env.example for Node, apps/api/appsettings.Development.json
# for .NET). These two values are just documented here for convenience.
WEB_URL={{frontendUrl}}
API_URL={{apiUrl}}
